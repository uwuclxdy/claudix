#!/usr/bin/env bash
# bootstrap shim — resolves the native claudix binary via the cache,
# downloading it on first use, then execs it with the caller's args
set -uo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
default_plugin_root="$(cd -- "${script_dir}/.." && pwd)"

if [[ -z "${CLAUDE_PLUGIN_ROOT:-}" || ! -x "${CLAUDE_PLUGIN_ROOT}/scripts/ensure-binary.sh" ]]; then
  export CLAUDE_PLUGIN_ROOT="$default_plugin_root"
fi

ensure_script="${CLAUDE_PLUGIN_ROOT}/scripts/ensure-binary.sh"

# fast path: binary already cached (or, in development_mode, the cargo binary)
binary="$(bash "$ensure_script" --check-only 2>/dev/null)"
status=$?
if [[ $status -eq 0 && -n "$binary" ]]; then
  exec "$binary" "$@"
fi

# development_mode is on but the cargo binary is missing: surface the hint
# synchronously and never download. hook wrappers swallow this exit and stay
# open; mcp propagates it so the failure is visible. cargo_bin is recomputed
# here (matching ensure-binary.sh's cargo_bin_path) only for the hint text;
# resolution itself stays in the script.
if [[ $status -eq 3 ]]; then
  cargo_bin="${CARGO_HOME:-${HOME}/.cargo}/bin/claudix"
  # shellcheck disable=SC2016  # backticks are literal hint text, not a subshell
  printf 'claudix: development_mode on but no cargo binary at %s — run `cargo install --path .` from the claudix repo\n' "$cargo_bin" >&2
  exit 1
fi

# cache miss: spawn install detached and fail-fast.
# blocking would either burn the mcp startup timeout or stall a hook;
# the user gets one degraded session and the binary is ready next time.
nohup bash "$ensure_script" --install >/dev/null 2>&1 &
disown 2>/dev/null || true

if [[ "${1:-}" == "mcp" ]]; then
  printf 'claudix: native binary not yet cached — downloading in background, restart Claude Code once it completes\n' >&2
  exit 1
fi

printf 'claudix: binary installing in background; hooks activate on next session start\n' >&2
exit 0
