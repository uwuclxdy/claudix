#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
default_plugin_root="$(cd -- "${script_dir}/.." && pwd)"

if [[ -z "${CLAUDE_PLUGIN_ROOT:-}" || ! -x "${CLAUDE_PLUGIN_ROOT}/scripts/ensure-binary.sh" ]]; then
  export CLAUDE_PLUGIN_ROOT="$default_plugin_root"
fi

if [[ -z "${CLAUDE_PLUGIN_DATA:-}" ]]; then
  export CLAUDE_PLUGIN_DATA="${CLAUDE_PLUGIN_ROOT}/.claudix-data"
fi

ensure_script="${CLAUDE_PLUGIN_ROOT}/scripts/ensure-binary.sh"

# Fast path: use binary if already installed (never blocks)
if binary="$("$ensure_script" --check-only 2>/dev/null)"; then
  # Check for newer version in background — survives parent exit
  nohup "$ensure_script" --update >/dev/null 2>&1 &
  disown 2>/dev/null || true
  exec "$binary" "$@"
fi

# Binary not yet installed: spawn install in background, fail open
nohup "$ensure_script" >/dev/null 2>&1 &
disown 2>/dev/null || true
printf 'claudix: binary installing in background; hooks activate on next session start\n' >&2
exit 0
